# ==============================================================================
# MOTION TENNIS — TEMPLATE DE CONFIGURAÇÃO CLOUD / NOTEBOOK DA QUADRA
# ==============================================================================
# Diretrizes de Segurança:
# 1. Copie este arquivo para .env.local (nunca comite chaves reais no repositório).
# 2. O notebook físico na quadra utiliza APENAS a chave pública anon e sua credencial
#    individual de equipamento (EQUIPMENT_ID e EQUIPMENT_API_KEY).
# 3. NUNCA distribua a SUPABASE_SERVICE_ROLE_KEY para os notebooks físicos das quadras
#    ou para o aplicativo Android. Ela é exclusiva para manutenção e migrações do administrador.
# ==============================================================================

# URL base do projeto Supabase (Ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (Segura para mobile e notebook com RLS e RPCs)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_anon_public_key

# Credencial Individual e Revogável do Equipamento da Quadra
# (Gerada pelo administrador na tabela equipments/equipment_secrets)
EQUIPMENT_ID=00000000-0000-0000-0000-000000000000
EQUIPMENT_API_KEY=mt_eq_live_exemplo_chave_individual_da_quadra
EQUIPMENT_HARDWARE_CODE=COURT_NOTEBOOK_01
EQUIPMENT_LOCATION="Quadra Principal - FECAP"
EQUIPMENT_WALL_PRESET=3x2

# Configuração de Telemetria e Outbox
HEARTBEAT_INTERVAL_SECONDS=60
OUTBOX_SYNC_INTERVAL_SECONDS=30
OUTBOX_BATCH_SIZE=25
